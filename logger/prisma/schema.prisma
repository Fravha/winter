generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  firebaseUid String     @unique @map("firebase_uid")
  email       String     @unique
  displayName String?    @map("display_name")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  status      UserStatus @default(PENDING)
  lastLoginAt DateTime?  @map("last_login_at")
  auditLogs   AuditLog[] @relation("AuditActor")
  roles       UserRole?
  productionWorksCreated ProductionWork[] @relation("ProductionWorkCreator")
  grapeReceptionsCreated GrapeReception[] @relation("GrapeReceptionActor")
  productionMeasurementsCreated ProductionMeasurement[] @relation("ProductionMeasurementActor")
  productionWorkCorrections ProductionWorkCorrection[] @relation("ProductionWorkCorrectionActor")
  productionMeasurementCorrections ProductionMeasurementCorrection[] @relation("ProductionMeasurementCorrectionActor")
  grapeReceptionCorrections GrapeReceptionCorrection[] @relation("GrapeReceptionCorrectionActor")
  transformations Transformation[]
  productionLosses ProductionLoss[]
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  inventoryMovementsAsActor InventoryMovement[] @relation("InventoryMovementActor")
  inventoryMovementsAsNegativeStockAuthorizer InventoryMovement[] @relation("InventoryMovementAuthorizer")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @unique @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Articulo {
  id                   String                 @id @default(uuid()) @db.Uuid
  codigo               String
  codigoExterno        String?                @map("codigo_externo")
  nombre               String
  clasificacion        ArticuloClassification
  unidadMedida         ArticuloUnit           @map("unidad_medida")
  activo               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  inventoryLots        InventoryLot[]
  inventoryStocks      InventoryStock[]
  inventoryMovements   InventoryMovement[]
  purchaseLines        PurchaseLine[]
  compraItems          CompraItem[]
  productionWorkInputs ProductionWorkInput[]
  grapeReceptionItems GrapeReceptionItem[]

  @@index([codigo])
  @@index([codigoExterno])
  @@index([clasificacion, activo])
  @@map("articulos")
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Purchase {
  id           String         @id
  reference    String         @unique
  supplierName String         @map("supplier_name")
  total        Decimal        @db.Decimal(12, 2)
  purchasedAt  DateTime       @map("purchased_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  lines        PurchaseLine[]

  @@map("purchases")
}

model PurchaseLine {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId String       @map("purchase_id")
  articuloId String       @map("articulo_id") @db.Uuid
  quantity   Decimal      @db.Decimal(18, 3)
  unit       ArticuloUnit
  createdAt  DateTime     @default(now()) @map("created_at")
  purchase   Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  articulo   Articulo     @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@index([articuloId])
  @@map("purchase_lines")
}

model ProductionOrder {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                @unique
  status         ProductionOrderStatus @default(OPEN)
  startDate      DateTime              @map("start_date")
  observations   String?
  closedAt       DateTime?             @map("closed_at")
  closedByUserId String?               @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  version        Int                   @default(0)
  works          ProductionWork[]
  transformationOrders TransformationOrder[]
  batches        ProductionBatch[]
  grapeReceptions GrapeReception[]
  transformations Transformation[]
  productionLosses ProductionLoss[]

  @@index([status])
  @@index([startDate])

  @@map("production_orders")
}

enum ProductionBatchLedgerEntryType {
  GENERATED
  CONSUMED
  SEPARATED
  LOSS
  TRANSFERRED_TO_INVENTORY
}

model ProductionBatch {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String                @unique
  productionOrderId String               @map("production_order_id") @db.Uuid
  articuloId       String                @map("articulo_id") @db.Uuid
  unit             String
  createdAt        DateTime              @default(now()) @map("created_at")
  observations     String?
  version          Int                   @default(0)
  productionOrder  ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  ledger           ProductionBatchLedgerEntry[]
  balance          ProductionBatchBalance?
  containerOccupancies ProductionContainerOccupancy[]
  containerMovementsFrom ProductionBatchContainerMovement[] @relation("ContainerMovementSourceBatch")
  containerMovementsTo ProductionBatchContainerMovement[] @relation("ContainerMovementDestinationBatch")
  parents          ProductionBatchLineage[] @relation("BatchLineageChild")
  children         ProductionBatchLineage[] @relation("BatchLineageParent")
  workLinks         ProductionWorkBatch[]
  receptionItem     GrapeReceptionItem?
  measurements      ProductionMeasurement[]
  transformationInputs TransformationInput[]
  transformationOutputs TransformationOutput[]
  productionLosses ProductionLoss[]

  @@index([productionOrderId])
  @@index([articuloId])
  @@index([createdAt])
  @@map("production_batches")
}

model ProductionBatchLedgerEntry {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionBatchId String                        @map("production_batch_id") @db.Uuid
  entryType        ProductionBatchLedgerEntryType @map("entry_type")
  quantity         Decimal                        @db.Decimal(18, 3)
  unit             String
  transformationId String?                        @map("transformation_id") @db.Uuid
  productionWorkId String?                        @map("production_work_id") @db.Uuid
  productionLossId String?                        @map("production_loss_id") @db.Uuid
  operationKey     String                         @map("operation_key")
  createdAt        DateTime                       @default(now()) @map("created_at")
  occurredAt       DateTime                       @map("occurred_at")
  actorUserId      String                         @map("actor_user_id") @db.Uuid
  metadata         Json?
  productionBatch  ProductionBatch               @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  transformation   Transformation?              @relation(fields: [transformationId], references: [id], onDelete: Restrict)
  productionLoss   ProductionLoss?              @relation(fields: [productionLossId], references: [id], onDelete: Restrict)

  @@unique([operationKey])
  @@index([productionBatchId, occurredAt, id], map: "production_batch_ledger_entries_batch_occurred_idx")
  @@index([entryType, occurredAt], map: "production_batch_ledger_entries_type_occurred_idx")
  @@index([transformationId], map: "production_batch_ledger_entries_transformation_idx")
  @@index([productionWorkId], map: "production_batch_ledger_entries_work_idx")
  @@map("production_batch_ledger_entries")
}

model ProductionBatchBalance {
  productionBatchId      String         @id @map("production_batch_id") @db.Uuid
  generated              Decimal        @db.Decimal(18, 3)
  consumed              Decimal        @db.Decimal(18, 3)
  separated             Decimal        @db.Decimal(18, 3)
  lost                  Decimal        @db.Decimal(18, 3)
  transferredToInventory Decimal        @map("transferred_to_inventory") @db.Decimal(18, 3)
  available              Decimal        @db.Decimal(18, 3)
  ledgerVersion          Int            @map("ledger_version")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  productionBatch        ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)

  @@map("production_batch_balances")
}

model ProductionBatchLineage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentBatchId  String         @map("parent_batch_id") @db.Uuid
  childBatchId   String         @map("child_batch_id") @db.Uuid
  quantity       Decimal?       @db.Decimal(18, 3)
  unit           String?
  createdAt      DateTime       @default(now()) @map("created_at")
  operationKey   String         @map("operation_key")
  parentBatch    ProductionBatch @relation("BatchLineageParent", fields: [parentBatchId], references: [id], onDelete: Restrict)
  childBatch     ProductionBatch @relation("BatchLineageChild", fields: [childBatchId], references: [id], onDelete: Restrict)

  @@unique([parentBatchId, childBatchId, operationKey], map: "production_batch_lineage_parent_child_operation_key")
  @@index([parentBatchId], map: "production_batch_lineage_parent_idx")
  @@index([childBatchId], map: "production_batch_lineage_child_idx")
  @@map("production_batch_lineage")
}

model ProductionBatchOperation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationKey String   @unique @map("operation_key")
  operation    String
  requestHash  String   @map("request_hash")
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("production_batch_operations")
}

enum ProductionContainerStatus {
  DISPONIBLE
  OCUPADO
  FUERA_DE_SERVICIO
}

enum ProductionBatchContainerMovementType {
  ASSIGNED
  TRANSFERRED
  PARTIAL_TRANSFERRED
}

model ProductionContainer {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                   @unique
  capacity    Decimal                  @db.Decimal(18, 3)
  capacityUnit String                  @map("capacity_unit")
  status      ProductionContainerStatus @default(DISPONIBLE)
  observations String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  version     Int                      @default(0)
  occupancies ProductionContainerOccupancy[]
  movementsFrom ProductionBatchContainerMovement[] @relation("ContainerMovementSource")
  movementsTo   ProductionBatchContainerMovement[] @relation("ContainerMovementDestination")
  workLinks ProductionWorkContainer[]
  measurements ProductionMeasurement[]

  @@index([status, code], map: "production_containers_status_code_idx")
  @@map("production_containers")
}

model ProductionContainerOccupancy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  containerId String   @map("container_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String
  openedAt    DateTime @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(0)
  container   ProductionContainer @relation(fields: [containerId], references: [id], onDelete: Restrict, map: "production_container_occupancies_container_fkey")
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, map: "production_container_occupancies_batch_fkey")

  @@index([containerId, closedAt, openedAt], map: "production_container_occupancies_container_idx")
  @@index([batchId, closedAt, openedAt], map: "production_container_occupancies_batch_idx")
  @@map("production_container_occupancies")
}

model ProductionBatchContainerMovement {
  id                 String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movementType       ProductionBatchContainerMovementType @map("movement_type")
  sourceContainerId  String?                              @map("source_container_id") @db.Uuid
  destinationContainerId String                           @map("destination_container_id") @db.Uuid
  sourceBatchId      String                               @map("source_batch_id") @db.Uuid
  destinationBatchId String?                              @map("destination_batch_id") @db.Uuid
  quantity           Decimal                              @db.Decimal(18, 3)
  unit               String
  operationKey       String                               @map("operation_key")
  requestHash        String                               @map("request_hash")
  occurredAt         DateTime                             @map("occurred_at")
  actorUserId        String                               @map("actor_user_id") @db.Uuid
  metadata           Json?
  createdAt          DateTime                             @default(now()) @map("created_at")
  sourceContainer    ProductionContainer? @relation("ContainerMovementSource", fields: [sourceContainerId], references: [id], onDelete: Restrict, map: "production_batch_container_movements_source_container_fkey")
  destinationContainer ProductionContainer @relation("ContainerMovementDestination", fields: [destinationContainerId], references: [id], onDelete: Restrict, map: "production_batch_container_movements_destination_container_fkey")
  sourceBatch        ProductionBatch @relation("ContainerMovementSourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict, map: "production_batch_container_movements_source_batch_fkey")
  destinationBatch   ProductionBatch? @relation("ContainerMovementDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: Restrict, map: "production_batch_container_movements_destination_batch_fkey")

  @@unique([operationKey])
  @@index([destinationContainerId, occurredAt], map: "production_batch_container_movements_destination_idx")
  @@index([sourceBatchId, occurredAt], map: "production_batch_container_movements_source_batch_idx")
  @@map("production_batch_container_movements")
}

model ProductionContainerOperation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationKey String   @unique @map("operation_key")
  operation    String
  requestHash  String   @map("request_hash")
  result       Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("production_container_operations")
}

model TransformationOrder {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String
  productionOrderId String               @map("production_order_id") @db.Uuid
  status           ProductionOrderStatus @default(OPEN)
  periodStart      DateTime              @map("period_start")
  periodEnd        DateTime?             @map("period_end")
  observations     String?
  closedAt         DateTime?             @map("closed_at")
  closedByUserId   String?               @map("closed_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  version          Int                   @default(0)
  productionOrder  ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  works ProductionWork[]
  transformations Transformation[]
  productionLosses ProductionLoss[]

  @@unique([productionOrderId, code])
  @@index([productionOrderId, status])
  @@index([periodStart, periodEnd])
  @@map("transformation_orders")
}

model ProductionWork {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String                @map("production_order_id") @db.Uuid
  transformationOrderId String?           @map("transformation_order_id") @db.Uuid
  workTypeId        String                @map("work_type_id") @db.Uuid
  performedAt       DateTime              @map("performed_at")
  observations      String?
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  version           Int                   @default(0)
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  transformationOrder TransformationOrder? @relation(fields: [transformationOrderId], references: [id], onDelete: Restrict)
  workType          WorkType              @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("ProductionWorkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  inputs            ProductionWorkInput[]
  batches           ProductionWorkBatch[]
  containers        ProductionWorkContainer[]
  participants      ProductionWorkParticipant[]
  corrections       ProductionWorkCorrection[]
  measurements      ProductionMeasurement[]
  transformations Transformation[]
  productionLosses ProductionLoss[]

  @@index([productionOrderId])
  @@map("production_works")
}

model ProductionWorkBatch {
  productionWorkId String @map("production_work_id") @db.Uuid
  productionBatchId String @map("production_batch_id") @db.Uuid
  productionWork ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  @@id([productionWorkId, productionBatchId])
  @@index([productionBatchId])
  @@map("production_work_batches")
}

model Transformation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String @map("production_order_id") @db.Uuid
  transformationOrderId String? @map("transformation_order_id") @db.Uuid
  productionWorkId String? @map("production_work_id") @db.Uuid
  performedAt DateTime @map("performed_at")
  actorUserId String @map("actor_user_id") @db.Uuid
  observations String?
  operationKey String @unique @map("operation_key")
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at")
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  transformationOrder TransformationOrder? @relation(fields: [transformationOrderId], references: [id], onDelete: Restrict)
  productionWork ProductionWork? @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  inputs TransformationInput[]
  outputs TransformationOutput[]
  losses ProductionLoss[]
  ledgerEntries ProductionBatchLedgerEntry[]
  @@index([productionOrderId, performedAt])
  @@index([transformationOrderId])
  @@index([productionWorkId])
  @@map("transformations")
}

model TransformationInput {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transformationId String @map("transformation_id") @db.Uuid
  productionBatchId String @map("production_batch_id") @db.Uuid
  quantity Decimal @db.Decimal(18,3)
  unit String
  createdAt DateTime @default(now()) @map("created_at")
  transformation Transformation @relation(fields: [transformationId], references: [id], onDelete: Restrict)
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  @@index([transformationId])
  @@index([productionBatchId])
  @@map("transformation_inputs")
}

model TransformationOutput {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transformationId String @map("transformation_id") @db.Uuid
  productionBatchId String @map("production_batch_id") @db.Uuid
  quantity Decimal @db.Decimal(18,3)
  unit String
  createdAt DateTime @default(now()) @map("created_at")
  transformation Transformation @relation(fields: [transformationId], references: [id], onDelete: Restrict)
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  @@index([transformationId])
  @@index([productionBatchId])
  @@map("transformation_outputs")
}

model ProductionLoss {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String @map("production_order_id") @db.Uuid
  transformationOrderId String? @map("transformation_order_id") @db.Uuid
  transformationId String? @map("transformation_id") @db.Uuid
  productionWorkId String? @map("production_work_id") @db.Uuid
  productionBatchId String? @map("production_batch_id") @db.Uuid
  quantity Decimal @db.Decimal(18,3)
  unit String
  occurredAt DateTime @map("occurred_at")
  actorUserId String @map("actor_user_id") @db.Uuid
  observations String?
  operationKey String @unique @map("operation_key")
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at")
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  transformationOrder TransformationOrder? @relation(fields: [transformationOrderId], references: [id], onDelete: Restrict)
  transformation Transformation? @relation(fields: [transformationId], references: [id], onDelete: Restrict)
  productionWork ProductionWork? @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  productionBatch ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  ledgerEntries ProductionBatchLedgerEntry[]
  @@index([productionOrderId, occurredAt])
  @@index([transformationId])
  @@index([productionBatchId])
  @@map("production_losses")
}

model ProductionWorkContainer {
  productionWorkId String @map("production_work_id") @db.Uuid
  productionContainerId String @map("production_container_id") @db.Uuid
  productionWork ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  productionContainer ProductionContainer @relation(fields: [productionContainerId], references: [id], onDelete: Restrict)
  @@id([productionWorkId, productionContainerId])
  @@index([productionContainerId])
  @@map("production_work_containers")
}

model ProductionWorkParticipant {
  productionWorkId String @map("production_work_id") @db.Uuid
  productionParticipantId String @map("production_participant_id") @db.Uuid
  role String?
  productionWork ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  productionParticipant ProductionParticipant @relation(fields: [productionParticipantId], references: [id], onDelete: Restrict)
  @@id([productionWorkId, productionParticipantId])
  @@index([productionParticipantId])
  @@map("production_work_participants")
}

model ProductionWorkCorrection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionWorkId String @map("production_work_id") @db.Uuid
  field String
  previousValue Json @map("previous_value")
  newValue Json @map("new_value")
  reason String
  correctedAt DateTime @map("corrected_at")
  actorUserId String @map("actor_user_id") @db.Uuid
  fromVersion Int @map("from_version")
  toVersion Int @map("to_version")
  productionWork ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  actor User @relation("ProductionWorkCorrectionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@unique([productionWorkId, toVersion], map: "production_work_corrections_work_to_version_key")
  @@index([productionWorkId, correctedAt])
  @@index([productionWorkId, fromVersion, toVersion], map: "production_work_corrections_work_version_idx")
  @@map("production_work_corrections")
}

model ProductionWorkInput {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionWorkId String         @map("production_work_id") @db.Uuid
  articuloId       String         @map("articulo_id") @db.Uuid
  quantity         Decimal        @db.Decimal(18, 3)
  unit             ArticuloUnit
  createdAt        DateTime       @default(now()) @map("created_at")
  productionWork   ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  articulo         Articulo       @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@index([articuloId])
  @@map("production_work_inputs")
}

model WorkType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  works ProductionWork[]
  @@index([active], map: "production_work_types_active_idx")
  @@map("production_work_types")
}

model MeasurementType {
