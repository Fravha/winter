generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  firebaseUid String     @unique @map("firebase_uid")
  email       String     @unique
  displayName String?    @map("display_name")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  status      UserStatus @default(PENDING)
  lastLoginAt DateTime?  @map("last_login_at")
  auditLogs   AuditLog[] @relation("AuditActor")
  roles       UserRole?
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  inventoryMovementsAsActor InventoryMovement[] @relation("InventoryMovementActor")
  inventoryMovementsAsNegativeStockAuthorizer InventoryMovement[] @relation("InventoryMovementAuthorizer")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @unique @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Articulo {
  id                   String                 @id @default(uuid()) @db.Uuid
  codigo               String
  codigoExterno        String?                @map("codigo_externo")
  nombre               String
  clasificacion        ArticuloClassification
  unidadMedida         ArticuloUnit           @map("unidad_medida")
  activo               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  inventoryLots        InventoryLot[]
  inventoryStocks      InventoryStock[]
  inventoryMovements   InventoryMovement[]
  purchaseLines        PurchaseLine[]
  compraItems          CompraItem[]
  productionWorkInputs ProductionWorkInput[]

  @@index([codigo])
  @@index([codigoExterno])
  @@index([clasificacion, activo])
  @@map("articulos")
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Purchase {
  id           String         @id
  reference    String         @unique
  supplierName String         @map("supplier_name")
  total        Decimal        @db.Decimal(12, 2)
  purchasedAt  DateTime       @map("purchased_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  lines        PurchaseLine[]

  @@map("purchases")
}

model PurchaseLine {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId String       @map("purchase_id")
  articuloId String       @map("articulo_id") @db.Uuid
  quantity   Decimal      @db.Decimal(18, 3)
  unit       ArticuloUnit
  createdAt  DateTime     @default(now()) @map("created_at")
  purchase   Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  articulo   Articulo     @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@index([articuloId])
  @@map("purchase_lines")
}

model ProductionOrder {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                @unique
  status         ProductionOrderStatus @default(OPEN)
  startDate      DateTime              @map("start_date")
  observations   String?
  closedAt       DateTime?             @map("closed_at")
  closedByUserId String?               @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  version        Int                   @default(0)
  works          ProductionWork[]
  transformationOrders TransformationOrder[]

  @@index([status])
  @@index([startDate])

  @@map("production_orders")
}

model TransformationOrder {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String
  productionOrderId String               @map("production_order_id") @db.Uuid
  status           ProductionOrderStatus @default(OPEN)
  periodStart      DateTime              @map("period_start")
  periodEnd        DateTime?             @map("period_end")
  observations     String?
  closedAt         DateTime?             @map("closed_at")
  closedByUserId   String?               @map("closed_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  version          Int                   @default(0)
  productionOrder  ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, code])
  @@index([productionOrderId, status])
  @@index([periodStart, periodEnd])
  @@map("transformation_orders")
}

model ProductionWork {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String                @map("production_order_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  inputs            ProductionWorkInput[]

  @@index([productionOrderId])
  @@map("production_works")
}

model ProductionWorkInput {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionWorkId String         @map("production_work_id") @db.Uuid
  articuloId       String         @map("articulo_id") @db.Uuid
  quantity         Decimal        @db.Decimal(18, 3)
  unit             ArticuloUnit
  createdAt        DateTime       @default(now()) @map("created_at")
  productionWork   ProductionWork @relation(fields: [productionWorkId], references: [id], onDelete: Restrict)
  articulo         Articulo       @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@index([articuloId])
  @@map("production_work_inputs")
}

model WorkType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([active], map: "production_work_types_active_idx")
  @@map("production_work_types")
}

model MeasurementType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([active], map: "production_measurement_types_active_idx")
  @@map("production_measurement_types")
}

model ProductionParticipant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  userId String? @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([active], map: "production_participants_active_idx")
  @@index([userId], map: "production_participants_user_id_idx")
  @@map("production_participants")
}

model Producer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([active], map: "production_producers_active_idx")
  @@map("production_producers")
}

model GrapeVariety {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([active], map: "production_grape_varieties_active_idx")
  @@map("production_grape_varieties")
}

enum CustomFieldEntityType {
  PRODUCER
  GRAPE_VARIETY
  GRAPE_RECEPTION
}

enum CustomFieldDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
}

model CustomFieldDefinition {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType CustomFieldEntityType @map("entity_type")
  code String
  label String
  dataType CustomFieldDataType @map("data_type")
  required Boolean @default(false)
  active Boolean @default(true)
  options Json?
  displayOrder Int @default(0) @map("display_order")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  values CustomFieldValue[]
  @@unique([entityType, code], map: "production_custom_field_definitions_entity_type_code_key")
  @@index([entityType, active, displayOrder], map: "production_custom_field_definitions_list_idx")
  @@map("production_custom_field_definitions")
}

model CustomFieldValue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definitionId String @map("definition_id") @db.Uuid
  entityType CustomFieldEntityType @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  textValue String? @map("text_value")
  integerValue Int? @map("integer_value")
  decimalValue Decimal? @map("decimal_value") @db.Decimal(18, 6)
  booleanValue Boolean? @map("boolean_value")
  dateValue DateTime? @map("date_value")
  selectValue String? @map("select_value")
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, map: "production_custom_field_values_definition_id_fkey")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([definitionId, entityId], map: "production_custom_field_values_definition_id_entity_id_key")
  @@index([entityType, entityId], map: "production_custom_field_values_entity_idx")
  @@index([definitionId], map: "production_custom_field_values_definition_idx")
  @@map("production_custom_field_values")
}

model Warehouse {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo          String
  nombre          String
  ubicacion       String?
  encargadoUserId String?             @map("encargado_user_id") @db.Uuid
  activo          Boolean             @default(true)
  observaciones   String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  stocks          InventoryStock[]
  sourceMovements InventoryMovement[] @relation("InventoryMovementSourceWarehouse")
  destinationMovements InventoryMovement[] @relation("InventoryMovementDestinationWarehouse")
  manager         User?               @relation("WarehouseManager", fields: [encargadoUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "warehouses_manager_user_id_fkey")

  @@map("warehouses")
}

model InventoryLot {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotCode                 String                     @map("lot_code")
  articuloId              String                     @map("articulo_id") @db.Uuid
  originProductionBatchId String?                    @map("origin_production_batch_id")
  classification          InventoryLotClassification
  fechaIngreso            DateTime                   @map("fecha_ingreso")
  observations            String?
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  stocks                  InventoryStock[]
  movements               InventoryMovement[]
  articulo                Articulo                   @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@unique([articuloId, lotCode])
  @@map("inventory_lots")
}

model InventoryStock {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId    String        @map("warehouse_id") @db.Uuid
  articuloId     String        @map("articulo_id") @db.Uuid
  inventoryLotId String?       @map("inventory_lot_id") @db.Uuid
  quantity       Decimal       @db.Decimal(18, 3)
  unit           ArticuloUnit
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_stocks_warehouse_id_fkey")
  lot            InventoryLot? @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_stocks_lot_id_fkey")
  articulo       Articulo      @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@map("inventory_stocks")
}

model InventoryMovement {
  id                            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                          InventoryMovementType
  source                        String
  reason                        String?
  articuloId                    String                @map("articulo_id") @db.Uuid
  warehouseId                   String                @map("warehouse_id") @db.Uuid
  destinationWarehouseId        String?               @map("destination_warehouse_id") @db.Uuid
  inventoryLotId                String?               @map("inventory_lot_id") @db.Uuid
  quantity                      Decimal               @db.Decimal(18, 3)
  unit                          ArticuloUnit
  stockBefore                   Decimal               @map("stock_before") @db.Decimal(18, 3)
  resultingStock                Decimal               @map("resulting_stock") @db.Decimal(18, 3)
  actorUserId                   String?               @map("actor_user_id") @db.Uuid
  negativeStockAuthorized       Boolean               @default(false) @map("negative_stock_authorized")
  negativeStockAuthorizerUserId String?               @map("negative_stock_authorizer_user_id") @db.Uuid
  negativeStockReason           String?               @map("negative_stock_reason")
  createdAt                     DateTime              @default(now()) @map("created_at")
  warehouse                     Warehouse             @relation("InventoryMovementSourceWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_movements_warehouse_id_fkey")
  destinationWarehouse          Warehouse?            @relation("InventoryMovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_movements_destination_warehouse_id_fkey")
  lot                           InventoryLot?         @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_movements_lot_id_fkey")
  articulo                      Articulo              @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  actor                         User?                 @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "inventory_movements_actor_user_id_fkey")
  negativeStockAuthorizer       User?                 @relation("InventoryMovementAuthorizer", fields: [negativeStockAuthorizerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "inventory_movements_authorizer_user_id_fkey")
  compraMovementRefs            CompraInventoryMovementReference[]

  @@index([articuloId, warehouseId, inventoryLotId, createdAt], map: "inventory_movements_position_idx")
  @@map("inventory_movements")
}

model InventoryIdempotency {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String
  operation          String
  requestFingerprint String   @map("request_fingerprint")
  response           Json
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([key])
  @@map("inventory_idempotency")
}

model Compra {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierName     String       @map("supplier_name")
  supplierTaxId    String?      @map("supplier_tax_id")
  documentNumber   String?      @map("document_number")
  documentDate     DateTime?    @map("document_date")
  currency         String?
  observations     String?
  status           CompraStatus @default(REGISTERED)
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  items            CompraItem[]
  movementRefs     CompraInventoryMovementReference[]

  @@index([status, createdAt])
  @@map("compras")
}

model CompraItem {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compraId          String       @map("compra_id") @db.Uuid
  articuloId        String       @map("articulo_id") @db.Uuid
  brand             String?
  requestedQuantity Decimal      @map("requested_quantity") @db.Decimal(18, 3)
  unit              ArticuloUnit
  unitPrice         Decimal?     @map("unit_price") @db.Decimal(18, 3)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  compra            Compra       @relation(fields: [compraId], references: [id], onDelete: Restrict)
  articulo          Articulo     @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  movementRefs      CompraInventoryMovementReference[]

  @@unique([compraId, articuloId])
  @@index([articuloId])
  @@map("compra_items")
}

model CompraInventoryMovementReference {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compraId        String            @map("compra_id") @db.Uuid
  compraItemId    String            @map("compra_item_id") @db.Uuid
  inventoryMovementId String         @map("inventory_movement_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  compra          Compra            @relation(fields: [compraId], references: [id], onDelete: Restrict)
  compraItem      CompraItem        @relation(fields: [compraItemId], references: [id], onDelete: Restrict)
  inventoryMovement InventoryMovement @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)

  @@unique([compraItemId])
  @@unique([compraItemId, inventoryMovementId], map: "compra_inventory_movement_references_compra_item_id_inventory_m")
  @@index([compraId])
  @@index([inventoryMovementId])
  @@map("compra_inventory_movement_references")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ArticuloClassification {
  MATERIA_PRIMA
  INSUMO_ENOLOGICO
  MATERIAL_ENVASE
  MATERIAL_EMPAQUE
  PRODUCTO_PROCESO
  PRODUCTO_ENVASADO
  PRODUCTO_TERMINADO
}

enum ArticuloUnit {
  KG
  G
  L
  M
  UNIDAD
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
}

enum InventoryLotClassification {
  PRODUCTO_ENVASADO
  PRODUCTO_TERMINADO
  PRODUCTO_TERMINADO_EXPORTACION
}

enum ProductionOrderStatus {
  OPEN
  CLOSED
}

enum CompraStatus {
  REGISTERED
  RECEIVED
  CANCELLED
}
