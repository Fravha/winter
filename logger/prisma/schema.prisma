  destinationWarehouse          Warehouse?            @relation("InventoryMovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_movements_destination_warehouse_id_fkey")
